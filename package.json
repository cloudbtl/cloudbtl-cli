{
  "name": "cloudbtl",
  "version": "0.1.0",
  "description": "CLI for cloudbtl.com — share documents and see who opened them, how far they read, and what they clicked. Upload PDF/HTML/MD/PPTX, manage share links, folders and workspaces, host images, read analytics.",
  "type": "module",
  "bin": {
    "cloudbtl": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cloudbtl",
    "docsend",
    "document-sharing",
    "share-links",
    "document-analytics",
    "read-tracking",
    "pdf",
    "cli"
  ],
  "homepage": "https://cloudbtl.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudbtl/cloudbtl-cli.git"
  },
  "bugs": {
    "url": "https://github.com/cloudbtl/cloudbtl-cli/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  }
}
